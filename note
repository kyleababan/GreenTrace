// pushing in to the main
git init
git add .
git commit -m ""
git push -u origin main

// fetching tommy's work

git branch // check if its on assistant-work, not on main
git pull

//check which branch youre in
git branch

// if its on main then do
git switch assistant-work
git pull

//if pushing your work to assistant-work
git add .
git commit -m ""
git push origin assistant-work


//do this after pushing your work to assistant-work
git switch main
git pull origin main
git fetch origin
git merge origin/assistant-work
git push origin main